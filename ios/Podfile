# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, '15.5'
prepare_react_native_project!

$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true
use_frameworks! :linkage => :static

target 'PxViewR' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
    )
    installer.pods_project.build_configurations.each do |build_config|
      build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
    end
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.5'
        build_config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      end
    end
  end

  post_integrate do |installer|
    installer.aggregate_targets.map(&:user_project).uniq.each do |user_project|
      modified = false
      user_project.native_targets.each do |target|
        target.shell_script_build_phases.each do |phase|
          next unless phase.name == '[CP-User] [RNFB] Crashlytics Configuration'
          next if phase.shell_script.include?('PXVIEW_SKIP_CRASHLYTICS_WITHOUT_GSP')
          guard = <<~'SH'
            # PXVIEW_SKIP_CRASHLYTICS_WITHOUT_GSP
            GSP_PATH="${BUILT_PRODUCTS_DIR}/${UNLOCALIZED_RESOURCES_FOLDER_PATH}/GoogleService-Info.plist"
            if [ ! -f "$GSP_PATH" ] || grep -Eq "placeholder|YOUR_|REPLACE_ME" "$GSP_PATH"; then
              echo "info: Skipping Firebase Crashlytics dSYM upload (GoogleService-Info.plist missing or placeholder)."
              exit 0
            fi
          SH
          phase.shell_script = phase.shell_script.sub(/\A(#![^\n]*\n)?/, "\\1#{guard}\n")
          modified = true
        end
      end
      user_project.save if modified
    end
  end
end
