rules_version = '2';

// Prototype data model
// users/{uid}: uid, email, displayName, createdAt, updatedAt
// feedback/{feedbackId}: uid, email, feedback, createdAt, metadata

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function hasOnly(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function validOptionalString(data, field, maxLength) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLength);
    }

    function validUserProfile(data, uid) {
      return hasOnly(data, ['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
        data.uid == uid &&
        data.email is string && data.email.size() > 2 && data.email.size() <= 254 &&
        validOptionalString(data, 'displayName', 100) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validFeedback(data) {
      return hasOnly(data, ['uid', 'email', 'feedback', 'createdAt', 'metadata']) &&
        data.uid == request.auth.uid &&
        data.feedback is string &&
        data.feedback.size() > 0 && data.feedback.size() <= 5000 &&
        validOptionalString(data, 'email', 254) &&
        data.createdAt is timestamp &&
        (!('metadata' in data) || data.metadata is map);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUserProfile(request.resource.data, uid);
      allow update: if isOwner(uid) &&
        validUserProfile(request.resource.data, uid) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(uid);
    }

    match /feedback/{feedbackId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() && validFeedback(request.resource.data);
      allow update: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        validFeedback(request.resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
